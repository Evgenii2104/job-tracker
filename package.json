{
  "name": "backend-foundation-intensive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:check": "tsx scripts/db/check.ts",
    "db:clean": "tsx scripts/db/clean.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "seed:base": "node scripts/lab/index.mjs prepare 1",
    "seed:day1:indexes": "node scripts/lab/index.mjs indexes",
    "seed:scenario:n-plus-one": "node scripts/lab/index.mjs nplusone",
    "web:install": "npm --prefix web ci",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:test": "npm --prefix web test",
    "web:preview": "npm --prefix web run preview",
    "lab": "node scripts/lab/index.mjs",
    "lab:test": "node --test tests/lab/core.test.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.17",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
